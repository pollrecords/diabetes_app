rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidRecipe(data) {
      return data.keys().hasOnly([
          'name',
          'description',
          'prepTime',
          'cookTime',
          'servings',
          'ingredients',
          'instructions',
          'authorId',
          'createdAt'
        ])
        && data.keys().hasAll([
          'name',
          'description',
          'prepTime',
          'cookTime',
          'servings',
          'ingredients',
          'instructions',
          'createdAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 2000
        && data.prepTime is int
        && data.prepTime >= 0
        && data.prepTime <= 1440
        && data.cookTime is int
        && data.cookTime >= 0
        && data.cookTime <= 1440
        && data.servings is int
        && data.servings > 0
        && data.servings <= 100
        && data.ingredients is list
        && data.ingredients.size() > 0
        && data.ingredients.size() <= 100
        && data.instructions is list
        && data.instructions.size() > 0
        && data.instructions.size() <= 100
        && data.createdAt == request.time;
    }

    match /recipes/{recipeId} {
      allow read: if true;
      allow create: if isValidRecipe(request.resource.data);
      allow update, delete: if false;
    }

    match /user_input/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
